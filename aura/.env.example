# ---- App ----
APP_NAME=AuraCafe
PORT=3000
DB_PATH=./data.db

# ---- Stellar ----
STELLAR_NETWORK=testnet            # testnet | public
# HORIZON_URL=https://horizon-testnet.stellar.org
ESCROW_SECRET=                      # corre: npm run setup:escrow
ASSET_CODE=XLM                      # XLM o USDC
ASSET_ISSUER=                       # solo si ASSET_CODE != XLM

# ---- Precios ----
MXN_PER_UNIT=6                      # cuántos MXN vale 1 unidad del asset (tipo de cambio fijo para el demo)
DELIVERY_FEE_MXN=15                 # va completo al Runner
PLATFORM_FEE_MXN=3                  # se queda en la cuenta escrow (modelo de negocio)

# ---- Demo ----
# true = no toca la red: pagos y liquidaciones simuladas (plan B si falla el wifi en la presentación)
SIMULATE_PAYMENTS=false
